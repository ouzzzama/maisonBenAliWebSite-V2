// Maison Ben Ali — CRM & business management schema.
//
// Default provider is PostgreSQL. For MySQL: switch `provider` to "mysql",
// drop the @db.* attributes and replace every `String[]` field with `Json`
// (MySQL has no native array type) — nothing else in the schema depends on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ users */

enum Role {
  OWNER
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emails EmailMessage[] @relation("EmailOwner")
  notes  Interaction[]
}

/* ------------------------------------------------------- leads & clients */

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ServiceInterest {
  ACHAT
  VENTE
  LOCATION
  CONCIERGERIE
  CARS
  PROJET
  VEFA
  GESTION
}

model Lead {
  id         String          @id @default(cuid())
  fullName   String
  email      String?
  phone      String?
  company    String?
  status     LeadStatus      @default(NEW)
  interest   ServiceInterest @default(ACHAT)
  source     String?         @default("Site web")
  budget     Decimal?        @db.Decimal(12, 2)
  notes      String?
  tags       String[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  client       Client?
  interactions Interaction[]
  emails       EmailMessage[]

  @@index([status, interest])
  @@index([createdAt])
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  company   String?
  address   String?
  tags      String[]
  notes     String?
  leadId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  rentals      CarRental[]
  projects     Project[]
  transactions Transaction[]
  interactions Interaction[]

  @@index([createdAt])
}

enum Channel {
  EMAIL
  CALL
  WHATSAPP
  MEETING
  NOTE
}

model Interaction {
  id         String   @id @default(cuid())
  channel    Channel  @default(NOTE)
  summary    String
  occurredAt DateTime @default(now())
  leadId     String?
  clientId   String?
  userId     String?

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
}

/* ------------------------------------------------------- unified inbox --- */

enum EmailStatus {
  UNREAD
  READ
  ARCHIVED
  CONVERTED
}

model EmailMessage {
  id         String      @id @default(cuid())
  fromName   String?
  fromEmail  String
  toEmail    String
  cc         String?
  subject    String
  snippet    String?
  body       String      @db.Text
  status     EmailStatus @default(UNREAD)
  provider   String      @default("imap") // imap | resend | sendgrid | manual
  threadKey  String? // groups a conversation (References / In-Reply-To)
  isOutbound Boolean     @default(false)
  receivedAt DateTime    @default(now())
  readAt     DateTime?

  leadId   String?
  ownerId  String?

  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner User? @relation("EmailOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([threadKey])
}

/* ------------------------------------------------------------- bookings -- */

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  reference   String        @unique
  clientName  String
  clientEmail String?
  clientPhone String?
  serviceType String
  startsAt    DateTime
  endsAt      DateTime?
  status      BookingStatus @default(PENDING)
  price       Decimal?      @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([status, startsAt])
}

/* ------------------------------------------------------------- rentals -- */

enum RentalStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model CarRental {
  id              String       @id @default(cuid())
  reference       String       @unique
  vehicle         String
  vehiclePlate    String?
  clientName      String
  clientEmail     String?
  clientPhone     String?
  pickupAt        DateTime
  dropoffAt       DateTime
  pickupLocation  String       @default("Agadir — Aéroport Al Massira")
  dailyRate       Decimal      @db.Decimal(10, 2)
  totalPrice      Decimal?     @db.Decimal(12, 2)
  deposit         Decimal?     @db.Decimal(10, 2)
  depositPaid     Boolean      @default(false)
  agreementSigned Boolean      @default(false)
  driverName      String?
  driverLicense   String?
  notes           String?
  status          RentalStatus @default(RESERVED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([status, pickupAt])
}

/* ------------------------------------------------------------- projects -- */

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  status      ProjectStatus @default(PLANNED)
  budget      Decimal?      @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  tags        String[]
  milestones  Json? // [{ title, dueAt, done }]
  coverUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  media        MediaAsset[]

  @@index([status])
}

/* --------------------------------------------------------- transactions -- */

enum TransactionType {
  PAYMENT
  DEPOSIT
  REFUND
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
}

model Transaction {
  id         String            @id @default(cuid())
  reference  String            @unique
  label      String
  amount     Decimal           @db.Decimal(12, 2)
  type       TransactionType   @default(PAYMENT)
  status     TransactionStatus @default(PENDING)
  method     String? // virement | espèces | carte | chèque
  stream     String? // booking | rental | project | other
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())

  clientId  String?
  bookingId String? @unique
  rentalId  String? @unique
  projectId String?

  client  Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  booking Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rental  CarRental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, occurredAt])
  @@index([stream])
}

/* ---------------------------------------------------------------- media -- */

enum PageSlot {
  HOME_HERO
  HOME_GALLERY
  ABOUT_HERO
  CONTACT_BANNER
  PORTFOLIO_COVER
  PROJECTS_SHOWCASE
  CARS_BANNER
  BLOG_COVER
  OTHER
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String
  filename   String
  alt        String?
  mimeType   String   @default("image/jpeg")
  size       Int?
  width      Int?
  height     Int?
  pageSlot   PageSlot @default(OTHER)
  sectionKey String? // e.g. "home.hero", "contact.banner"
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([pageSlot, sortOrder])
}
