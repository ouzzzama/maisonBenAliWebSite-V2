# PostgreSQL (Neon en production : URL pooled pour l'exécution)
DATABASE_URL="postgresql://user:password@localhost:5432/maisonbenali_crm?schema=public"

# Connexion directe Neon, réservée aux migrations (prisma migrate)
DIRECT_URL="postgresql://user:password@localhost:5432/maisonbenali_crm?schema=public"

# MySQL : passer provider = "mysql" dans prisma/schema.prisma puis
# DATABASE_URL="mysql://user:password@localhost:3306/maisonbenali_crm"

# Envoi / réception d'emails (module Boîte de réception)
# Boîte Hostinger : smtp.hostinger.com / 465 (SSL). `npm run mail:test` vérifie la boîte.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="direction@maisonbenali.com"
SMTP_PASSWORD="mot-de-passe-de-la-boite"
MAIL_FROM="Maison Benali <direction@maisonbenali.com>"

# Webhooks entrants (Resend / SendGrid Inbound Parse)
INBOUND_WEBHOOK_SECRET=""

# ------------------------------------------- Stockage des images (Hostinger)
# Les images envoyées depuis le CRM partent par FTP dans le panneau Fichiers
# Hostinger, puis sont servies par le site vitrine (aucune data-URL en base).
# hPanel → Fichiers → Comptes FTP : créer un compte dont le dossier racine est
# public_html, et coller ici l'hôte, l'utilisateur et le mot de passe.
# Sans ces valeurs, les images restent dans crm/.uploads et sont servies par
# le CRM sur /uploads/<fichier> (mode développement uniquement).
HOSTINGER_FTP_HOST="ftp.maisonbenali.com"
HOSTINGER_FTP_PORT="21"
HOSTINGER_FTP_USER="u123456789"
HOSTINGER_FTP_PASSWORD="mot-de-passe-ftp"
# true = FTPS explicite (port 21), "implicit" = FTPS implicite (port 990), false = FTP simple
HOSTINGER_FTP_SECURE="true"
# Dossier distant, relatif au compte FTP (racine public_html recommandée)
HOSTINGER_FTP_DIR="/public_html/uploads/crm"
# URL publique correspondant à ce dossier sur le site
MEDIA_PUBLIC_URL="https://maisonbenali.com/uploads/crm"

# Ancien emplacement S3 (non utilisé pour l'instant)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------ Sécurité
# Secret de signature des cookies de session (32+ caractères aléatoires)
AUTH_SECRET="changez-moi-32-caracteres-minimum"

# Administrateur autorisé à se connecter au CRM (reçoit le code par e-mail)
ADMIN_EMAIL="ouzzzama10@gmail.com"
ADMIN_NAME="Fouad Benali"
ADMIN_PASSWORD="choisissez-un-mot-de-passe-fort"

# Passer à "true" quand le CRM est servi en HTTPS (cookie Secure)
AUTH_COOKIE_SECURE="false"

# Affiche le code OTP à l'écran quand SMTP n'est pas encore configuré
AUTH_SHOW_DEV_OTP="true"

# Origine du site autorisée à appeler /api/public/*
WEBSITE_ORIGIN="http://localhost:3001"

# URL publique du site vitrine
NEXT_PUBLIC_SITE_URL="https://maisonbenali.com"
