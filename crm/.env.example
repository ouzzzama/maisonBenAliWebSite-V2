# PostgreSQL (par défaut dans prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/maisonbenali_crm?schema=public"

# MySQL : passer provider = "mysql" dans prisma/schema.prisma puis
# DATABASE_URL="mysql://user:password@localhost:3306/maisonbenali_crm"

# Envoi / réception d'emails (module Boîte de réception)
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="contact@maisonbenali.com"

# Webhooks entrants (Resend / SendGrid Inbound Parse)
INBOUND_WEBHOOK_SECRET=""

# Stockage médias (S3 / Supabase Storage)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------ Sécurité
# Secret de signature des cookies de session (32+ caractères aléatoires)
AUTH_SECRET="changez-moi-32-caracteres-minimum"

# Administrateur autorisé à se connecter au CRM
ADMIN_EMAIL="contact@maisonbenali.com"
ADMIN_NAME="Fouad Benali"
ADMIN_PASSWORD="choisissez-un-mot-de-passe-fort"

# Passer à "true" quand le CRM est servi en HTTPS (cookie Secure)
AUTH_COOKIE_SECURE="false"

# Affiche le code OTP à l'écran quand SMTP n'est pas encore configuré
AUTH_SHOW_DEV_OTP="true"

# Origine du site autorisée à appeler /api/public/*
WEBSITE_ORIGIN="http://localhost:3001"
