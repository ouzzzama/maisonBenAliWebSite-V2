{
  "name": "maison-benali-web-app",
  "version": "1.0.0",
  "description": "Maison Benali - L'excellence Immobilière à Agadir",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/cache-bust.mjs && node scripts/build-site.mjs",
